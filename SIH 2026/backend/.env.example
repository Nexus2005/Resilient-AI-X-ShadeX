# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=development

# Supabase project URL and direct Postgres connection string
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
DATABASE_URL=postgresql://postgres:URL-ENCODED-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
DB_SCHEMA=public

# Auth (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
SESSION_TTL_MINUTES=720

# Storage
STORAGE_BACKEND=local
STORAGE_BUCKET=resilient-documents
STORAGE_ROOT=var/storage

# Uploads (Module 1 intake limits)
MAX_UPLOAD_SIZE_MB=25
MAX_BUNDLE_SIZE_MB=120
MAX_BUNDLE_FILES=40
MAX_ARCHIVE_ENTRIES=60
MAX_ARCHIVE_UNCOMPRESSED_MB=120

# Gemini (optional; leave empty to run fully deterministic)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# OCR / processing
OCR_DPI=220
OCR_TEXT_MIN_CHARS=30
OCR_LOW_CONFIDENCE=0.55

# Module 1 classification review bands (rule confidence, not calibrated probability)
CLASSIFICATION_AUTO_CONFIDENCE=0.75
CLASSIFICATION_REVIEW_CONFIDENCE=0.45

# CORS
# Explicit origins are always allowed. In development any localhost port is accepted
# automatically (Next.js uses 3001/3002 when 3000 is busy); set the regex explicitly to override.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_REGEX=

# Reports
REPORT_ROOT=var/reports
