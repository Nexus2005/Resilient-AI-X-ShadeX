KEYS.txt
*.key
*.pem
*.pfx
*.pkcs12
.env
.env.*
!.env.example
!.env.template
secrets.json
credentials.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
